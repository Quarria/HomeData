generator client {
  provider = "prisma-client"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
}

enum SystemRole {
  USER
  SYSTEM_ADMIN
}

enum AccountStatus {
  ACTIVE
  DISABLED
}

enum FamilyStatus {
  ACTIVE
  ARCHIVED
}

enum ReceiptPrivacy {
  PRIVATE
  FAMILY
}

enum AiRunType {
  RECEIPT_EXTRACTION
  ANALYSIS
  WARDROBE_RECOGNITION
  WARDROBE_RECOMMENDATION
}

enum GarmentCategory {
  TOP
  OUTERWEAR
  BOTTOM
  ONE_PIECE
  SHOES
  ACCESSORY
}

enum GarmentSeason {
  SPRING
  SUMMER
  AUTUMN
  WINTER
}

enum GarmentLayer {
  INNER
  MID
  OUTER
}

enum GarmentScene {
  COMMUTE
  CASUAL
  SPORT
}

enum GarmentStatus {
  WEARABLE
  LAUNDERING
  STORED
  RETIRED
}

enum GarmentVisibility {
  PRIVATE
  FAMILY
}

enum OutfitItemRole {
  TOP
  MID
  OUTER
  BOTTOM
  ONE_PIECE
  SHOES
  ACCESSORY
}

enum AiRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum TaskStatus {
  OPEN
  DONE
}

enum RecurringFrequency {
  MONTHLY
  YEARLY
}

enum RecurringStatus {
  ACTIVE
  PAUSED
}

enum OccurrenceStatus {
  PENDING
  PAID
  SKIPPED
}

model Category {
  id             String          @id @default(uuid()) @db.Uuid
  code           String          @unique @db.VarChar(32)
  name           String          @db.VarChar(40)
  sortOrder      Int             @default(0) @map("sort_order")
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  expenses       Expense[]
  recurringRules RecurringRule[]
  occurrences    Occurrence[]

  @@map("categories")
}

model Account {
  id                   String              @id @default(uuid()) @db.Uuid
  username             String              @unique @db.VarChar(40)
  usernameNormalized   String              @unique @map("username_normalized") @db.VarChar(40)
  nickname             String              @db.VarChar(80)
  passwordHash         String              @map("password_hash") @db.VarChar(255)
  systemRole           SystemRole          @default(USER) @map("system_role")
  status               AccountStatus       @default(ACTIVE)
  mustChangePassword   Boolean             @default(true) @map("must_change_password")
  authVersion          Int                 @default(1) @map("auth_version")
  version              Int                 @default(1)
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions             Session[]
  memberships          Membership[]
  administeredFamilies Family[]            @relation("FamilyAdministrator")
  auditsAsActor        AuditEvent[]        @relation("AuditActor")
  expensesPaid         Expense[]           @relation("ExpensePayer")
  receiptsUploaded     Receipt[]           @relation("ReceiptUploader")
  idempotencyRecords   IdempotencyRecord[]
  tasksCreated         Task[]              @relation("TaskCreator")
  tasksManaged         Task[]              @relation("TaskManager")
  tasksAssigned        Task[]              @relation("TaskAssignee")
  tasksCompleted       Task[]              @relation("TaskCompleter")
  recurringCreated     RecurringRule[]     @relation("RecurringCreator")
  recurringManaged     RecurringRule[]     @relation("RecurringManager")
  reminderPreference   ReminderPreference?
  inboxMessages        InboxMessage[]
  managedOccurrences   Occurrence[]
  shareSnapshots       ShareSnapshot[]
  aiRuns               AiRun[]
  aiDailyUsage         AiDailyUsage[]
  garmentsOwned        Garment[]           @relation("GarmentOwner")
  garmentsCreated      Garment[]           @relation("GarmentCreator")
  wardrobeImages       WardrobeImage[]
  outfits              Outfit[]

  @@map("accounts")
}

model Session {
  id          String    @id @default(uuid()) @db.Uuid
  accountId   String    @map("account_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  authVersion Int       @map("auth_version")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId])
  @@index([expiresAt])
  @@map("sessions")
}

model Family {
  id                   String            @id @default(uuid()) @db.Uuid
  name                 String            @db.VarChar(80)
  adminAccountId       String            @map("admin_account_id") @db.Uuid
  status               FamilyStatus      @default(ACTIVE)
  archivedAt           DateTime?         @map("archived_at") @db.Timestamptz(3)
  defaultCityName      String?           @map("default_city_name") @db.VarChar(120)
  defaultCityCountry   String?           @map("default_city_country") @db.VarChar(2)
  defaultCityLatitude  Float?            @map("default_city_latitude")
  defaultCityLongitude Float?            @map("default_city_longitude")
  defaultCityTimezone  String?           @map("default_city_timezone") @db.VarChar(64)
  version              Int               @default(1)
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  admin                Account           @relation("FamilyAdministrator", fields: [adminAccountId], references: [id], onDelete: Restrict)
  memberships          Membership[]
  expenses             Expense[]
  tasks                Task[]
  recurringRules       RecurringRule[]
  shareSnapshots       ShareSnapshot[]
  shareDependencies    ShareDependency[]
  aiRuns               AiRun[]
  garments             Garment[]

  @@index([adminAccountId, status])
  @@map("families")
}

model Membership {
  id            String         @id @default(uuid()) @db.Uuid
  familyId      String         @map("family_id") @db.Uuid
  accountId     String         @map("account_id") @db.Uuid
  joinedAt      DateTime       @default(now()) @map("joined_at") @db.Timestamptz(3)
  leftAt        DateTime?      @map("left_at") @db.Timestamptz(3)
  leaveReason   String?        @map("leave_reason") @db.VarChar(32)
  family        Family         @relation(fields: [familyId], references: [id], onDelete: Restrict)
  account       Account        @relation(fields: [accountId], references: [id], onDelete: Restrict)
  aiRuns        AiRun[]
  garmentShares GarmentShare[]

  @@index([familyId, leftAt, joinedAt])
  @@index([accountId, leftAt])
  @@map("memberships")
}

model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  actorId     String?  @map("actor_id") @db.Uuid
  action      String   @db.VarChar(80)
  subjectType String   @map("subject_type") @db.VarChar(40)
  subjectId   String?  @map("subject_id") @db.Uuid
  details     Json?    @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actor       Account? @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt])
  @@index([subjectType, subjectId, createdAt])
  @@map("audit_events")
}

model Expense {
  id                  String        @id @default(uuid()) @db.Uuid
  payerId             String        @map("payer_id") @db.Uuid
  familyId            String?       @map("family_id") @db.Uuid
  categoryId          String        @map("category_id") @db.Uuid
  title               String        @db.VarChar(120)
  occurredOn          DateTime      @map("occurred_on") @db.Date
  amountCents         BigInt        @map("amount_cents")
  quantity            Decimal?      @db.Decimal(12, 3)
  unit                String?       @db.VarChar(24)
  unitPrice           Decimal?      @map("unit_price") @db.Decimal(12, 2)
  note                String?       @db.VarChar(500)
  occurrenceId        String?       @map("occurrence_id") @db.Uuid
  deletedAt           DateTime?     @map("deleted_at") @db.Timestamptz(3)
  purgeAfter          DateTime?     @map("purge_after") @db.Timestamptz(3)
  deleteBatchId       String?       @map("delete_batch_id") @db.Uuid
  version             Int           @default(1)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  payer               Account       @relation("ExpensePayer", fields: [payerId], references: [id], onDelete: Restrict)
  family              Family?       @relation(fields: [familyId], references: [id], onDelete: Restrict)
  category            Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  refunds             Refund[]
  wardrobeGarments    Garment[]
  receiptLinks        ReceiptLink[]
  occurrence          Occurrence?   @relation("OccurrencePayments", fields: [occurrenceId], references: [id], onDelete: Restrict)
  activeForOccurrence Occurrence?   @relation("OccurrenceActiveExpense")

  @@index([payerId, occurredOn, id])
  @@index([familyId, occurredOn, id])
  @@index([categoryId, occurredOn])
  @@index([deletedAt, purgeAfter])
  @@map("expenses")
}

model Refund {
  id            String    @id @default(uuid()) @db.Uuid
  expenseId     String    @map("expense_id") @db.Uuid
  amountCents   BigInt    @map("amount_cents")
  occurredOn    DateTime  @map("occurred_on") @db.Date
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)
  purgeAfter    DateTime? @map("purge_after") @db.Timestamptz(3)
  deleteBatchId String?   @map("delete_batch_id") @db.Uuid
  version       Int       @default(1)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  expense       Expense   @relation(fields: [expenseId], references: [id], onDelete: Restrict)

  @@index([expenseId, occurredOn])
  @@index([deletedAt, purgeAfter])
  @@map("refunds")
}

model Receipt {
  id           String         @id @default(uuid()) @db.Uuid
  uploadedById String         @map("uploaded_by_id") @db.Uuid
  storageKey   String         @unique @map("storage_key") @db.VarChar(255)
  mimeType     String         @map("mime_type") @db.VarChar(40)
  sizeBytes    Int            @map("size_bytes")
  contentHash  String         @map("content_hash") @db.Char(64)
  privacyLock  ReceiptPrivacy @default(PRIVATE) @map("privacy_lock")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  uploadedBy   Account        @relation("ReceiptUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  links        ReceiptLink[]
  aiRuns       AiRun[]

  @@index([uploadedById, createdAt])
  @@map("receipts")
}

model ReceiptLink {
  id        String   @id @default(uuid()) @db.Uuid
  receiptId String   @map("receipt_id") @db.Uuid
  expenseId String   @map("expense_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  receipt   Receipt  @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  expense   Expense  @relation(fields: [expenseId], references: [id], onDelete: Restrict)

  @@unique([receiptId, expenseId])
  @@index([expenseId])
  @@map("receipt_links")
}

model IdempotencyRecord {
  id          String   @id @default(uuid()) @db.Uuid
  actorId     String   @map("actor_id") @db.Uuid
  operation   String   @db.VarChar(80)
  key         String   @db.Uuid
  requestHash String   @map("request_hash") @db.Char(64)
  response    Json?    @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)
  actor       Account  @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([actorId, operation, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}

model Task {
  id                  String     @id @default(uuid()) @db.Uuid
  familyId            String?    @map("family_id") @db.Uuid
  creatorId           String     @map("creator_id") @db.Uuid
  managerId           String     @map("manager_id") @db.Uuid
  managerMembershipId String?    @map("manager_membership_id") @db.Uuid
  assigneeId          String?    @map("assignee_id") @db.Uuid
  title               String     @db.VarChar(100)
  description         String?    @db.VarChar(2000)
  dueOn               DateTime   @map("due_on") @db.Date
  status              TaskStatus @default(OPEN)
  completedById       String?    @map("completed_by_id") @db.Uuid
  completedAt         DateTime?  @map("completed_at") @db.Timestamptz(3)
  deletedAt           DateTime?  @map("deleted_at") @db.Timestamptz(3)
  version             Int        @default(1)
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  family              Family?    @relation(fields: [familyId], references: [id], onDelete: Restrict)
  creator             Account    @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  manager             Account    @relation("TaskManager", fields: [managerId], references: [id], onDelete: Restrict)
  assignee            Account?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  completedBy         Account?   @relation("TaskCompleter", fields: [completedById], references: [id], onDelete: Restrict)

  @@index([familyId, status, dueOn])
  @@index([managerId, status, dueOn])
  @@map("tasks")
}

model RecurringRule {
  id                  String             @id @default(uuid()) @db.Uuid
  familyId            String?            @map("family_id") @db.Uuid
  creatorId           String             @map("creator_id") @db.Uuid
  managerId           String             @map("manager_id") @db.Uuid
  managerMembershipId String?            @map("manager_membership_id") @db.Uuid
  title               String             @db.VarChar(100)
  categoryId          String             @map("category_id") @db.Uuid
  frequency           RecurringFrequency
  anchorOn            DateTime           @map("anchor_on") @db.Date
  effectiveFromOn     DateTime           @map("effective_from_on") @db.Date
  expectedCents       BigInt?            @map("expected_cents")
  status              RecurringStatus    @default(ACTIVE)
  scheduleRevision    Int                @default(1) @map("schedule_revision")
  version             Int                @default(1)
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  family              Family?            @relation(fields: [familyId], references: [id], onDelete: Restrict)
  creator             Account            @relation("RecurringCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  manager             Account            @relation("RecurringManager", fields: [managerId], references: [id], onDelete: Restrict)
  category            Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  occurrences         Occurrence[]

  @@index([familyId, status])
  @@index([managerId, status])
  @@map("recurring_rules")
}

model Occurrence {
  id                 String           @id @default(uuid()) @db.Uuid
  ruleId             String           @map("rule_id") @db.Uuid
  periodKey          String           @map("period_key") @db.VarChar(7)
  dueOn              DateTime         @map("due_on") @db.Date
  titleSnapshot      String           @map("title_snapshot") @db.VarChar(100)
  categoryIdSnapshot String           @map("category_id_snapshot") @db.Uuid
  expectedCents      BigInt?          @map("expected_cents")
  managerId          String           @map("manager_id") @db.Uuid
  status             OccurrenceStatus @default(PENDING)
  activeExpenseId    String?          @unique @map("active_expense_id") @db.Uuid
  generatedAt        DateTime         @default(now()) @map("generated_at") @db.Timestamptz(3)
  scheduleRevision   Int              @map("schedule_revision")
  version            Int              @default(1)
  rule               RecurringRule    @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  manager            Account          @relation(fields: [managerId], references: [id], onDelete: Restrict)
  category           Category         @relation(fields: [categoryIdSnapshot], references: [id], onDelete: Restrict)
  activeExpense      Expense?         @relation("OccurrenceActiveExpense", fields: [activeExpenseId], references: [id], onDelete: Restrict)
  payments           Expense[]        @relation("OccurrencePayments")

  @@unique([ruleId, periodKey])
  @@index([dueOn, status])
  @@map("occurrences")
}

model ReminderPreference {
  accountId       String  @id @map("account_id") @db.Uuid
  localTime       String  @default("09:00") @map("local_time") @db.VarChar(5)
  taskAdvanceDays Int     @default(1) @map("task_advance_days")
  feeAdvanceDays  Int     @default(3) @map("fee_advance_days")
  overdueEnabled  Boolean @default(true) @map("overdue_enabled")
  account         Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@map("reminder_preferences")
}

model InboxMessage {
  id             String      @id @default(uuid()) @db.Uuid
  recipientId    String      @map("recipient_id") @db.Uuid
  slotAt         DateTime    @map("slot_at") @db.Timestamptz(3)
  state          String      @default("ACTIVE") @db.VarChar(16)
  readAt         DateTime?   @map("read_at") @db.Timestamptz(3)
  frozenAt       DateTime?   @map("frozen_at") @db.Timestamptz(3)
  payloadVersion Int         @default(1) @map("payload_version")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  recipient      Account     @relation(fields: [recipientId], references: [id], onDelete: Restrict)
  items          InboxItem[]

  @@unique([recipientId, slotAt])
  @@index([recipientId, readAt, createdAt])
  @@map("inbox_messages")
}

model InboxItem {
  id           String       @id @default(uuid()) @db.Uuid
  messageId    String       @map("message_id") @db.Uuid
  subjectType  String       @map("subject_type") @db.VarChar(24)
  subjectId    String       @map("subject_id") @db.Uuid
  reminderKind String       @map("reminder_kind") @db.VarChar(24)
  scheduledOn  DateTime     @map("scheduled_on") @db.Date
  message      InboxMessage @relation(fields: [messageId], references: [id], onDelete: Restrict)

  @@unique([messageId, subjectType, subjectId, reminderKind, scheduledOn])
  @@index([subjectType, subjectId])
  @@map("inbox_items")
}

model ShareSnapshot {
  id               String               @id @default(uuid()) @db.Uuid
  ownerId          String               @map("owner_id") @db.Uuid
  familyId         String?              @map("family_id") @db.Uuid
  tokenHash        String               @unique @map("token_hash") @db.Char(64)
  passcodeHash     String?              @map("passcode_hash") @db.VarChar(255)
  aggregatePayload Json                 @map("aggregate_payload") @db.JsonB
  rangeFrom        DateTime             @map("range_from") @db.Date
  rangeTo          DateTime             @map("range_to") @db.Date
  period           String               @db.VarChar(8)
  scopeLabel       String               @map("scope_label") @db.VarChar(80)
  generatedAt      DateTime             @default(now()) @map("generated_at") @db.Timestamptz(3)
  expiresAt        DateTime             @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime?            @map("revoked_at") @db.Timestamptz(3)
  invalidatedAt    DateTime?            @map("invalidated_at") @db.Timestamptz(3)
  purgeAfter       DateTime?            @map("purge_after") @db.Timestamptz(3)
  version          Int                  @default(1)
  owner            Account              @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  family           Family?              @relation(fields: [familyId], references: [id], onDelete: Restrict)
  dependencies     ShareDependency[]
  accessSessions   ShareAccessSession[]

  @@index([ownerId, generatedAt])
  @@index([familyId, generatedAt])
  @@index([expiresAt])
  @@index([purgeAfter])
  @@map("share_snapshots")
}

model ShareDependency {
  id           String        @id @default(uuid()) @db.Uuid
  snapshotId   String        @map("snapshot_id") @db.Uuid
  familyId     String        @map("family_id") @db.Uuid
  membershipId String?       @map("membership_id") @db.Uuid
  requiredRole String        @default("MEMBER") @map("required_role") @db.VarChar(10)
  snapshot     ShareSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  family       Family        @relation(fields: [familyId], references: [id], onDelete: Restrict)

  @@unique([snapshotId, familyId])
  @@index([familyId])
  @@map("share_dependencies")
}

model ShareAccessSession {
  id         String        @id @default(uuid()) @db.Uuid
  snapshotId String        @map("snapshot_id") @db.Uuid
  tokenHash  String        @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime      @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  snapshot   ShareSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)

  @@index([snapshotId, expiresAt])
  @@index([expiresAt])
  @@map("share_access_sessions")
}

model ShareUnlockAttempt {
  keyHash  String   @id @map("key_hash") @db.Char(64)
  windowAt DateTime @map("window_at") @db.Timestamptz(3)
  attempts Int      @default(0)

  @@map("share_unlock_attempts")
}

model AiRun {
  id              String         @id @default(uuid()) @db.Uuid
  actorId         String         @map("actor_id") @db.Uuid
  familyId        String?        @map("family_id") @db.Uuid
  membershipId    String?        @map("membership_id") @db.Uuid
  receiptId       String?        @map("receipt_id") @db.Uuid
  wardrobeImageId String?        @map("wardrobe_image_id") @db.Uuid
  type            AiRunType
  status          AiRunStatus    @default(PENDING)
  idempotencyKey  String         @map("idempotency_key") @db.Uuid
  input           Json           @db.JsonB
  result          Json?          @db.JsonB
  errorCode       String?        @map("error_code") @db.VarChar(40)
  providerUsage   Json?          @map("provider_usage") @db.JsonB
  usageDate       DateTime       @map("usage_date") @db.Date
  attempts        Int            @default(0)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  startedAt       DateTime?      @map("started_at") @db.Timestamptz(3)
  finishedAt      DateTime?      @map("finished_at") @db.Timestamptz(3)
  actor           Account        @relation(fields: [actorId], references: [id], onDelete: Restrict)
  family          Family?        @relation(fields: [familyId], references: [id], onDelete: Restrict)
  membership      Membership?    @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  receipt         Receipt?       @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  wardrobeImage   WardrobeImage? @relation(fields: [wardrobeImageId], references: [id], onDelete: Restrict)

  @@unique([actorId, idempotencyKey])
  @@index([status, createdAt])
  @@index([actorId, createdAt])
  @@index([familyId, createdAt])
  @@map("ai_runs")
}

model AiDailyUsage {
  accountId String   @map("account_id") @db.Uuid
  usageDate DateTime @map("usage_date") @db.Date
  bucket    String   @db.VarChar(32)
  reserved  Int      @default(0)
  succeeded Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@id([accountId, usageDate, bucket])
  @@map("ai_daily_usage")
}

model Garment {
  id              String            @id @default(uuid()) @db.Uuid
  ownerId         String            @map("owner_id") @db.Uuid
  createdById     String            @map("created_by_id") @db.Uuid
  familyId        String?           @map("family_id") @db.Uuid
  mainImageId     String            @unique @map("main_image_id") @db.Uuid
  expenseId       String?           @map("expense_id") @db.Uuid
  name            String            @db.VarChar(100)
  category        GarmentCategory
  color           String?           @db.VarChar(40)
  stylingAdvice   String?           @map("styling_advice") @db.VarChar(80)
  seasons         GarmentSeason[]   @default([])
  layers          GarmentLayer[]    @default([])
  scenes          GarmentScene[]    @default([])
  status          GarmentStatus     @default(WEARABLE)
  visibility      GarmentVisibility @default(PRIVATE)
  storageLocation String?           @map("storage_location") @db.VarChar(100)
  notes           String?           @db.VarChar(500)
  acquiredOn      DateTime?         @map("acquired_on") @db.Date
  version         Int               @default(1)
  deletedAt       DateTime?         @map("deleted_at") @db.Timestamptz(3)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  owner           Account           @relation("GarmentOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdBy       Account           @relation("GarmentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  family          Family?           @relation(fields: [familyId], references: [id], onDelete: Restrict)
  mainImage       WardrobeImage     @relation(fields: [mainImageId], references: [id], onDelete: Restrict)
  expense         Expense?          @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  shares          GarmentShare[]
  outfitItems     OutfitItem[]

  @@index([ownerId, deletedAt, status, id])
  @@index([familyId, visibility, deletedAt])
  @@index([expenseId])
  @@map("garments")
}

model WardrobeImage {
  id           String   @id @default(uuid()) @db.Uuid
  uploadedById String   @map("uploaded_by_id") @db.Uuid
  storageKey   String   @unique @map("storage_key") @db.VarChar(255)
  thumbnailKey String   @unique @map("thumbnail_key") @db.VarChar(255)
  mimeType     String   @map("mime_type") @db.VarChar(40)
  sizeBytes    Int      @map("size_bytes")
  width        Int
  height       Int
  contentHash  String   @map("content_hash") @db.Char(64)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  uploadedBy   Account  @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  garment      Garment?
  aiRuns       AiRun[]

  @@index([uploadedById, createdAt])
  @@index([contentHash])
  @@map("wardrobe_images")
}

model GarmentShare {
  id           String     @id @default(uuid()) @db.Uuid
  garmentId    String     @map("garment_id") @db.Uuid
  membershipId String     @map("membership_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  garment      Garment    @relation(fields: [garmentId], references: [id], onDelete: Restrict)
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Restrict)

  @@unique([garmentId, membershipId])
  @@index([membershipId])
  @@map("garment_shares")
}

model Outfit {
  id              String        @id @default(uuid()) @db.Uuid
  ownerId         String        @map("owner_id") @db.Uuid
  name            String        @db.VarChar(100)
  scene           GarmentScene?
  notes           String?       @db.VarChar(500)
  weatherSnapshot Json?         @map("weather_snapshot") @db.JsonB
  version         Int           @default(1)
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  owner           Account       @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  items           OutfitItem[]

  @@index([ownerId, deletedAt, updatedAt])
  @@map("outfits")
}

model OutfitItem {
  id        String         @id @default(uuid()) @db.Uuid
  outfitId  String         @map("outfit_id") @db.Uuid
  garmentId String         @map("garment_id") @db.Uuid
  role      OutfitItemRole
  sortOrder Int            @map("sort_order")
  outfit    Outfit         @relation(fields: [outfitId], references: [id], onDelete: Restrict)
  garment   Garment        @relation(fields: [garmentId], references: [id], onDelete: Restrict)

  @@unique([outfitId, garmentId])
  @@index([garmentId])
  @@map("outfit_items")
}

model WardrobeWeatherCache {
  id           String   @id @default(uuid()) @db.Uuid
  locationKey  String   @map("location_key") @db.VarChar(120)
  timezone     String   @db.VarChar(64)
  forecastFrom DateTime @map("forecast_from") @db.Date
  forecastTo   DateTime @map("forecast_to") @db.Date
  data         Json     @db.JsonB
  fetchedAt    DateTime @map("fetched_at") @db.Timestamptz(3)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([locationKey, forecastFrom, forecastTo])
  @@index([expiresAt])
  @@map("wardrobe_weather_cache")
}
