# Application runtime variables. Copy to deploy/runtime.env.
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
APP_ORIGIN=http://<server-ip>:8080
DATABASE_URL=postgresql://homedata_app:REPLACE_WITH_POSTGRES_APP_PASSWORD@db:5432/homedata?schema=public
RECEIPT_STORAGE_PATH=/data/receipts
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_A_DIFFERENT_32_CHAR_SECRET
AI_PROVIDER=disabled
AI_BASE_URL=https://api.deepseek.com
AI_VISION_MODEL=deepseek-flash
AI_ANALYSIS_MODEL=deepseek-v4-pro
AI_TIMEOUT_MS=90000
WECHAT_NOTIFICATIONS_ENABLED=false
