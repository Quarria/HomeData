NODE_ENV=production
PORT=3000
HOST=0.0.0.0
APP_ORIGIN=https://your-domain.example
DATABASE_URL=postgresql://homedata_app:REPLACE_ME@db:5432/homedata?schema=public
RECEIPT_STORAGE_PATH=/data/receipts
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_A_DIFFERENT_32_CHAR_SECRET
AI_PROVIDER=disabled
# Only set after selecting and configuring an approved provider.
# AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_VISION_MODEL=deepseek-flash
AI_ANALYSIS_MODEL=deepseek-v4-pro
AI_TIMEOUT_MS=90000
WECHAT_NOTIFICATIONS_ENABLED=false
POSTGRES_DB=homedata
POSTGRES_USER=homedata_owner
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
POSTGRES_APP_PASSWORD=REPLACE_WITH_ANOTHER_RANDOM_PASSWORD
