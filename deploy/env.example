# Docker Compose variables. Copy to deploy/.env and replace the passwords.
HTTP_PORT=80
HOMEDATA_IMAGE=homedata:latest
HOMEDATA_WEB_IMAGE=homedata-web:latest
POSTGRES_DATA_DIR=/home/docker/postgres
RECEIPTS_DATA_DIR=/home/docker/homedata/receipts
WARDROBE_DATA_DIR=/home/docker/homedata/wardrobe
POSTGRES_DB=homedata
POSTGRES_USER=homedata_owner
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_OWNER_PASSWORD
POSTGRES_APP_PASSWORD=REPLACE_WITH_RANDOM_APPLICATION_DATABASE_PASSWORD
